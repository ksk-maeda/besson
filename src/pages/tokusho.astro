---
import BaseLayout from '../layouts/BaseLayout.astro';

const rows: [string, string][] = [
  ['販売業者', 'リンテクト・ジャパン株式会社'],
  ['代表責任者', '前田 啓佑'],
  ['所在地', '〒350-1118 埼玉県川越市豊田本4丁目2−6'],
  ['電話番号', '050-1793-8059（受付時間：平日 10:00〜16:30／土日・祝日・GW・夏季休暇・年末年始を除く）'],
  ['メールアドレス', 'info@besson.jp'],
  ['販売URL', 'https://besson.jp（取得予定）'],
  ['販売価格', '各商品ページに記載の価格（税込）'],
  ['送料', '自社サイトでのご購入：送料無料（一部離島等を除く）'],
  ['お支払い方法', 'クレジットカード、各種決済サービス（Stripe決済）'],
  ['お支払い時期', 'ご注文時にお支払いが確定します。クレジットカードの引き落とし時期は各カード会社の規定に準じます。'],
  ['商品のお届け', 'ご注文確認後、通常3〜7営業日以内に発送します。大型モデル（C55以上）は玄関口までのお届けとなります。'],
  [
    '返品・交換',
    '【初期不良の場合】商品到着後、初期不良が確認された場合は交換対応いたします。お問い合わせフォームよりご連絡ください。【お客様都合による返品】未開封・未使用品に限り、商品到着後8日以内にご連絡いただいた場合のみ対応いたします。返送時の送料はお客様のご負担となります。※使用済み商品・開封済み商品のお客様都合による返品はお受けできません。',
  ],
  ['保証', '全モデルに製品保証が付属します。保証期間・内容は各商品ページをご確認ください。※落下・水濡れ・誤使用などお客様起因の故障は保証対象外となります。'],
  ['特記事項', '商品の色・外観は画面の設定により実物と異なって見える場合があります。'],
];
---

<BaseLayout title="特定商取引法に基づく表記" description="BESSON（リンテクト・ジャパン株式会社）の特定商取引法に基づく表記。">
  <section class="section tokusho">
    <div class="container tokusho__inner">
      <h1>特定商取引法に基づく表記</h1>
      <p class="tokusho__note">特定商取引に関する法律に基づき、以下の通り表記します。</p>

      <dl class="tokusho__table">
        {rows.map(([k, v]) => (
          <div class="tokusho__row">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .tokusho__inner { max-width: 680px; }
  .tokusho h1 { margin-bottom: 0.5rem; }
  .tokusho__note { color: var(--gray-mid); font-size: 0.85rem; margin-bottom: 2rem; }
  .tokusho__table { margin: 0; }
  .tokusho__row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--stone);
  }
  @media (max-width: 560px) {
    .tokusho__row { grid-template-columns: 1fr; gap: 0.3rem; }
  }
  .tokusho__row dt { font-size: 0.8rem; color: var(--gray-mid); }
  .tokusho__row dd { margin: 0; font-size: 0.85rem; line-height: 1.7; }
</style>
