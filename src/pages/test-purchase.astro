---
// 決済パイプラインの動作確認用の隠しページ。ナビ・サイトマップ・検索に一切出さない。
// 用途：本番モードで実カード決済→Slack通知→返金、の通し確認を¥100で行う。
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="動作確認用テスト購入"
  description="BESSON社内用の決済動作確認ページです。"
  noindex={true}
>
  <section class="section test-purchase">
    <div class="container test-purchase__inner">
      <p class="section-label">Internal Test</p>
      <h1>決済動作確認（社内用）</h1>
      <p class="test-purchase__note">
        このページはBESSON社内の決済テスト用です。「テスト商品（¥100）」を実際のカードで購入し、
        Slack通知の着弾を確認した後、Stripeダッシュボードから返金してください。
      </p>
      <button id="test-buy" class="btn btn--primary btn--large">テスト商品（¥100）を購入する</button>
    </div>
  </section>
</BaseLayout>

<script>
  import { clearCart, addToCart } from '../lib/cart';

  document.getElementById('test-buy')?.addEventListener('click', () => {
    // テスト時は他の商品が混ざらないようカートを一度空にする
    clearCart();
    addToCart({ slug: 'test-item', model: 'テスト商品（動作確認用）', price: '¥100' });
    window.location.href = '/checkout';
  });
</script>

<style>
  .test-purchase__inner { max-width: 480px; text-align: center; }
  .test-purchase h1 { margin: 0.5rem 0 1rem; font-size: 1.4rem; }
  .test-purchase__note {
    color: var(--gray-dark);
    font-size: 0.9rem;
    margin-bottom: 2rem;
    text-align: left;
    background: var(--cream);
    padding: 1rem;
  }
</style>
