---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../lib/categories';

const products = await getCollection('products');
const storyOrder = ['bistro', 'lounge', 'bar', 'grand-maison'];
const cats = storyOrder.map((k) => CATEGORIES.find((c) => c.key === k)!);

function productsFor(catKey: string) {
  return products.filter((p) => p.data.category === catKey).sort((a, b) => a.data.bottles - b.data.bottles);
}
---

<BaseLayout title="Shop" description="BESSONの購入は自社サイトから直接お求めいただけます。全11モデルの一覧から選べます。">
  <section class="section shop">
    <div class="container">
      <h1>Shop</h1>
      <p class="shop__lead">
        BESSONは自社サイトから直接お求めいただけます。
      </p>

      {cats.map((c) => (
        <div class="shop__group">
          <h2>{c.name}</h2>
          <table class="shop__table">
            <tbody>
              {productsFor(c.key).map((p) => (
                <tr>
                  <td><a href={`/products/${p.id}`}>BESSON {p.data.model}</a></td>
                  <td>{p.data.bottles}本</td>
                  <td>{p.data.price}</td>
                  <td>
                    <button
                      class="btn btn--outline shop__buy"
                      data-slug={p.id}
                      data-model={p.data.model}
                      data-price={p.data.price}
                    >
                      カートに追加
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script type="module">
  import { addToCart } from '../lib/cart';

  document.querySelectorAll('.shop__buy').forEach((btn) => {
    btn.addEventListener('click', () => {
      addToCart({ slug: btn.dataset.slug, model: btn.dataset.model, price: btn.dataset.price });
      btn.textContent = '追加しました';
      setTimeout(() => (btn.textContent = 'カートに追加'), 1200);
    });
  });
</script>

<style>
  .shop h1 { margin-bottom: 1rem; }
  .shop__lead { color: var(--gray-dark); margin-bottom: 2.5rem; }
  .shop__group { margin-bottom: 2.5rem; }
  .shop__group h2 { font-family: var(--font-en); font-size: 1.1rem; margin-bottom: 1rem; color: var(--gold); }
  .shop__table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .shop__table td { padding: 0.7rem 0.5rem; border-bottom: 1px solid var(--stone); vertical-align: middle; }
  .shop__table a:not(.btn) { text-decoration: underline; }
  .shop__buy { font-size: 0.75rem; padding: 0.5rem 0.9rem; white-space: nowrap; }
</style>
