---
import { CATEGORIES } from '../lib/categories';
// 物語順ナビ。モバイル最優先＝ロゴ＋ハンバーガーのみ（サイトガイド.md準拠）
// 2026-08-11: けいさんFB「ハンバーガーメニューだけでは何を売っているブランドか分からない」を受け、
// 各シリーズに本数レンジと導入一文を追加。凍結済みのシリーズ名・コピーは変更していない。
const navOrder = ['bistro', 'lounge', 'bar', 'grand-maison'];
const navItems = navOrder.map((k) => CATEGORIES.find((c) => c.key === k)!);
---

<header class="site-header">
  <div class="site-header__bar container">
    <a href="/" class="logo">BESSON</a>
    <div class="site-header__actions">
      <a href="/cart" class="cart-link" aria-label="カート">
        Cart<span id="cart-count" class="cart-link__count" hidden>0</span>
      </a>
      <button id="hamburger" class="hamburger" aria-label="メニューを開く" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="navDrawer" class="nav-drawer">
    <p class="nav-drawer__intro">ワインセラー、5つの空間から選ぶ。</p>
    <ul>
      {navItems.map((c) => (
        <li>
          <a href={`/${c.slug}`}>
            <span class="nav-drawer__name">{c.name}</span>
            <span class="nav-drawer__meta">{c.bottleRange}</span>
          </a>
        </li>
      ))}
      <li><a href="/story">Our Story</a></li>
      <li><a href="/shop">Shop（全モデル一覧）</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/faq">FAQ</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(249, 248, 246, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--stone);
  }
  .site-header__bar {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--font-en);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--black);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .cart-link {
    position: relative;
    font-family: var(--font-en);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--black);
  }
  .cart-link__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.3rem;
    margin-left: 0.3rem;
    background: var(--black);
    color: var(--white);
    border-radius: 999px;
    font-size: 0.65rem;
    font-family: var(--font-ja);
  }
  .hamburger {
    background: none;
    border: none;
    width: 28px;
    height: 20px;
    position: relative;
    cursor: pointer;
    padding: 0;
  }
  .hamburger span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--black);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .hamburger span:nth-child(1) { top: 2px; }
  .hamburger span:nth-child(2) { top: 10px; }
  .hamburger span:nth-child(3) { top: 18px; }
  .hamburger.open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .nav-drawer {
    max-height: 0;
    overflow: hidden;
    background: var(--off-white);
    border-bottom: 1px solid var(--stone);
    transition: max-height 0.35s ease;
  }
  .nav-drawer.open { max-height: 520px; }
  .nav-drawer__intro {
    padding: 1rem var(--px-lg) 0;
    font-family: var(--font-ja-serif);
    font-size: 1rem;
    color: var(--gray-dark);
  }
  .nav-drawer ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--px-lg) 1.5rem;
  }
  .nav-drawer li { border-bottom: 1px solid var(--stone); }
  .nav-drawer a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 0;
    font-family: var(--font-en), var(--font-ja);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--black);
  }
  .nav-drawer__meta {
    font-family: var(--font-ja);
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--gray-readable);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
</style>

<script>
  const hbg = document.getElementById('hamburger');
  const drawer = document.getElementById('navDrawer');
  hbg?.addEventListener('click', () => {
    const isOpen = hbg.classList.toggle('open');
    drawer?.classList.toggle('open');
    hbg.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<script type="module">
  import { getCart, cartCount } from '../lib/cart';

  function renderBadge() {
    const el = document.getElementById('cart-count');
    if (!el) return;
    const count = cartCount(getCart());
    el.textContent = String(count);
    el.hidden = count === 0;
  }

  renderBadge();
  window.addEventListener('besson:cart-updated', renderBadge);
</script>
