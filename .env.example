# このファイルをコピーして .env にリネームし、実際の値を入れる（.envはgit管理外）。
# 本番運用時はVercelプロジェクトの Environment Variables に同じ内容を設定する。

# Stripeダッシュボード（https://dashboard.stripe.com/apikeys）から取得。
# 最初はテストモードのキー（sk_test_... / pk_test_...）でよい。
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# StripeのWebhookエンドポイント設定（https://dashboard.stripe.com/webhooks）で
# /api/stripe-webhook を登録すると発行される署名シークレット
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# 注文のSlack通知用。SlackのIncoming Webhook URL
# （api.slack.com/apps → アプリ作成 → Incoming Webhooks → チャンネル選択で発行）
# 未設定でも決済自体は動くが、通知は飛ばない（Stripeダッシュボードで確認は可能）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxx/xxxx/xxxx
